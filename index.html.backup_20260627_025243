<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>踢出"超"时代 — 中国草根足球联赛的万里长传</title>
<script src="./echarts.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #006837;
  --bg-light: #004d2a;
  --bg-card: #1A9850;
  --bg-hover: #66BD63;
  --text: #FFFFBF;
  --text2: #D9EF8B;
  --text3: #FFFFBF;
  --gold: #D9EF8B;
  --gold2: #FFFFBF;
  --fire: #A50026;
}

/* 全局文字对比度增强 */
.section { color: var(--text); }
.section .section-title, .section .section-subtitle, .section .story-text, .section .chart-title, .section .chart-desc, .section .hint-text, .section .kpi-value, .section .kpi-label, .section .stat-value, .section .stat-label { text-shadow: 0 1px 6px rgba(0,0,0,0.5); }
.section .section-title { text-shadow: 0 2px 10px rgba(0,0,0,0.6); }

/* 平滑背景层 */
#smooth-bg {
  position: fixed;
  inset: 0;
  z-index: -5;
  background-color: var(--bg);
  transition: background-color 1.5s ease;
  pointer-events: none;
}

/* 固定背景层（淡入淡出） */
#bg-hero, #bg-prologue {
  position: fixed;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: opacity 1.5s ease;
  pointer-events: none;
  z-index: -2;
}
#bg-hero {
  background-image: url('hero.png');
  opacity: 1;
  animation: heroZoom 25s infinite alternate ease-in-out;
}
#bg-prologue {
  background-image: url('prologue-bg.jpg');
  opacity: 0;
}

@keyframes heroZoom {
  0% { transform: scale(1) translateX(0); }
  100% { transform: scale(1.1) translateX(-2%); }
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body {
  background: linear-gradient(180deg, var(--bg) 0%, var(--bg-light) 30%, var(--bg) 100%);
  background-attachment: fixed;
  color: var(--text);
  font-family: "PingFang SC","Microsoft YaHei","Noto Sans SC",system-ui,sans-serif;
  overflow-x: hidden;
  line-height: 1.8;
}
body::before {
  content: "";
  position: fixed; inset: 0; pointer-events: none; z-index: -4;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,191,0.006) 2px, rgba(255,255,191,0.006) 4px);
}

/* Navigation */
#mainNav {
  position: fixed; top: 0; left: 0; width: 100%; z-index: 1000;
  background: rgba(0,104,55,0.85); backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(217,239,139,0.15);
  padding: 12px 5vw; display: flex; align-items: center; justify-content: space-between;
  transition: transform 0.3s ease;
}
#mainNav.hidden { transform: translateY(-100%); }
.nav-logo { font-size: 16px; font-weight: 700; color: var(--gold); display: flex; align-items: center; gap: 8px; }
.football-spin { display: inline-block; font-size: 20px; animation: spin 3s linear infinite; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.nav-links { display: flex; gap: 16px; list-style: none; }
.football-icon { display: inline-block; margin-right: 5px; font-size: 14px; vertical-align: middle; transition: transform 0.3s; }
.nav-links a:hover .football-icon, .nav-links a.active .football-icon { animation: bounce 0.6s ease infinite; }
@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
.nav-links a {
  color: var(--text2); text-decoration: none; font-size: 13px; white-space: nowrap;
  transition: color 0.2s; position: relative; padding-bottom: 2px;
  display: flex; align-items: center;
}
.nav-links a:hover, .nav-links a.active { color: var(--gold); }
.nav-links a.active::after {
  content: ""; position: absolute; bottom: -2px; left: 0; width: 100%; height: 2px;
  background: var(--gold); border-radius: 1px;
}
.nav-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: 8px;
  z-index: 1001;
}
.nav-hamburger span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--gold);
  border-radius: 2px;
  transition: all 0.3s ease;
}
.nav-hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.nav-hamburger.active span:nth-child(2) { opacity: 0; }
.nav-hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

/* Progress bar */
#progressBar {
  position: fixed; top: 0; left: 0; height: 3px; z-index: 1001;
  background: linear-gradient(90deg, var(--gold), var(--gold2));
  width: 0%; transition: width 0.1s linear;
}

/* Sections */
.section { min-height: 80vh; padding: 100px 5vw 60px; position: relative; z-index: 2; background-color: transparent; }
/* 奇偶板块背景交替 */
.section:nth-child(even) { color: #FFFFBF; }
.section:nth-child(even) .section-title { color: #FFFFBF; }
.section:nth-child(even) .section-subtitle { color: #FFFFBF; }
.section:nth-child(even) .chart-title { color: #FFFFBF; }
.section:nth-child(even) .chart-desc { color: #D9EF8B; }
.section:nth-child(even) .story-text { color: #FFFFBF; }
.section:nth-child(even) .hint-text { color: #FFFFBF; }
.section:nth-child(even) .kpi-card { background: rgba(255,255,191,0.08); border-color: rgba(217,239,139,0.2); }
.section:nth-child(even) .kpi-value { color: #FFFFBF; }
.section:nth-child(even) .kpi-label { color: #FFFFBF; }
.section:nth-child(even) .person-card { background: linear-gradient(180deg, rgba(26,152,80,0.8) 0%, rgba(0,104,55,0.9) 100%); border-color: rgba(217,239,139,0.15); }
.section:nth-child(even) .person-card-name { color: #D9EF8B; }
.section:nth-child(even) .person-card-title { color: #FFFFBF; }
.section:nth-child(even) .person-card-quote { color: #FFFFBF; border-color: #D9EF8B; }
.section:nth-child(even) .person-card-photo { background: linear-gradient(135deg, #1A9850, #66BD63); }
.section:nth-child(even) .modal-content { background: #1A9850; }
.section:nth-child(even) .logo-item { background: linear-gradient(135deg, #1A9850, #66BD63); border-color: rgba(217,239,139,0.2); color: #D9EF8B; }
.section:nth-child(even) .story-layout-text .name { color: #FFFFBF; }
.section:nth-child(even) .story-layout-text .body { color: #FFFFBF; }
.section:nth-child(even) .story-layout-text .quote { color: #FFFFBF; border-color: #FFFFBF; }
.section:nth-child(even) .story-layout-text .role { color: #FFFFBF; }
.section:nth-child(even) .story-layout-text .title { color: #FFFFBF; }
.section:nth-child(even) .story-layout-img { border-color: rgba(217,239,139,0.15); }

/* 奇数章节正文强制亮色 */
#ch1 .story-text, #ch3 .story-text, #ch5 .story-text,
#ch1 .section-subtitle, #ch3 .section-subtitle, #ch5 .section-subtitle,
#ch1 .section-badge, #ch3 .section-badge, #ch5 .section-badge { color: #FFFFBF; }

/* 全局文字对比度增强 */
.section { color: var(--text); }
.section .section-title, .section .section-subtitle, .section .story-text, .section .chart-title, .section .chart-desc, .section .hint-text, .section .kpi-value, .section .kpi-label, .section .stat-value, .section .stat-label { text-shadow: 0 1px 6px rgba(0,0,0,0.5); color: #FFFFBF; }
.section .section-title { text-shadow: 0 2px 10px rgba(0,0,0,0.6); color: #FFFFBF; }
.section .chart-title { color: #FFFFBF; }
.section .chart-desc { color: #D9EF8B; }
.section .kpi-value { color: #FFFFBF; }
.section .kpi-label { color: #FFFFBF; }
.section .section-badge { color: #FFFFBF; }

/* Prologue section with custom background */
#prologue {
  position: relative;
  overflow: hidden;
}
#prologue > * { position: relative; z-index: 1; }
#prologue::before {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,104,55,0.85) 0%, rgba(0,104,55,0.6) 40%, rgba(0,104,55,0.6) 60%, rgba(0,104,55,0.85) 100%);
  z-index: 0;
  pointer-events: none;
}
#prologue .section-badge,
#prologue .section-title,
#prologue .section-subtitle,
#prologue .story-text,
#prologue .story-layout-text .body,
#prologue .story-layout-text .name,
#prologue .story-layout-text .title,
#prologue .story-layout-text .quote { text-shadow: 0 2px 8px rgba(0,0,0,0.5); }

/* Chapter 1 overlay */
#ch1::before {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,60,35,0.3) 0%, rgba(0,60,35,0.1) 30%, rgba(0,60,35,0.1) 70%, rgba(0,60,35,0.3) 100%);
  z-index: 0;
  pointer-events: none;
}
#ch1 > * { position: relative; z-index: 1; }

/* 故事双栏布局 */
.story-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; max-width: 1000px; margin: 40px auto; }
.story-layout-img { background: linear-gradient(135deg, var(--bg-card), var(--bg-hover)); border-radius: 16px; max-width: 320px; overflow: hidden; border: 1px solid rgba(217,239,139,0.15); }
.story-layout-img img { width: 100%; height: auto; display: block; }
.story-layout-img svg { width: 120px; height: 120px; opacity: 0.3; }
.story-layout-text { text-align: left; }
.story-layout-text .role { font-size: 14px; color: var(--text3); margin-bottom: 8px; }
.story-layout-text .name { font-size: 28px; color: var(--gold); font-weight: 700; margin-bottom: 4px; }
.story-layout-text .title { font-size: 15px; color: var(--text3); margin-bottom: 16px; }
.story-layout-text .body { font-size: 18px; color: var(--text2); line-height: 2; }
.story-layout-text .quote { font-style: italic; color: var(--gold); margin-top: 24px; padding: 20px 24px; border-left: 4px solid var(--gold); background: rgba(26,58,26,0.4); border-radius: 0 12px 12px 0; position: relative; }
.story-layout-text .quote::before { content: ""; position: absolute; left: 12px; top: 12px; font-size: 48px; color: rgba(217,239,139,0.15); font-family: Georgia, serif; line-height: 1; }
.story-layout-text .quote-text { font-size: 20px; color: #D9EF8B; font-weight: 700; line-height: 1.8; text-shadow: 0 2px 8px rgba(0,0,0,0.4); position: relative; z-index: 1; }
.story-layout-text .quote-author { font-size: 14px; color: var(--text3); margin-top: 12px; font-style: normal; text-shadow: 0 1px 4px rgba(0,0,0,0.3); }
.story-layout-text .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 20px; }
.story-layout-text .stat-box { background: rgba(217,239,139,0.08); padding: 12px; border-radius: 8px; text-align: center; }
.story-layout-text .stat-box .val { font-size: 24px; color: var(--gold); font-weight: 700; }
.story-layout-text .stat-box .lbl { font-size: 12px; color: var(--text3); }

/* Logo 展示网格 */
.logo-grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px; padding: 16px; }
.logo-item { width: 100px; height: 100px; background: linear-gradient(135deg, #1A9850, #66BD63); border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(217,239,139,0.2); font-size: 14px; color: var(--gold); font-weight: 700; transition: transform 0.2s, box-shadow 0.2s; position: relative; overflow: hidden; cursor: pointer; }
.logo-item:hover { transform: translateY(-4px) scale(1.05); box-shadow: 0 8px 20px rgba(217,239,139,0.15); }
.logo-item::after { content: attr(data-name); position: absolute; inset: 0; background: rgba(0,104,55,0.85); display: flex; align-items: center; justify-content: center; font-size: 12px; color: #FFFFBF; opacity: 0; transition: opacity 0.3s; padding: 8px; text-align: center; }
.logo-item:hover::after { opacity: 1; }

.section-title {
  font-size: 42px; font-weight: 850; color: var(--gold); margin-bottom: 12px;
  letter-spacing: 2px; text-shadow: 0 0 40px rgba(217,239,139,0.15);
}
.section-subtitle { font-size: 16px; color: var(--text3); margin-bottom: 48px; }
.section-badge {
  display: inline-block; padding: 4px 14px; border: 1px solid var(--gold);
  border-radius: 20px; font-size: 12px; color: var(--gold); letter-spacing: 1.5px;
  margin-bottom: 16px;
}

/* Hero */
#hero {
  min-height: 100vh; display: flex; flex-direction: column; align-items: center;
  justify-content: center; text-align: center; position: relative; padding: 0 5vw;
  overflow: hidden;
}
#hero::before {
  content: ""; position: absolute; inset: 0; z-index: 1;
  background:
    linear-gradient(rgba(0,104,55,0.72), rgba(0,104,55,0.55)),
    radial-gradient(ellipse at 50% 50%, rgba(217,239,139,0.08) 0%, transparent 60%);
}
/* 固定背景层（淡入淡出） */
#bg-hero, #bg-prologue {
  position: fixed;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: opacity 1.5s ease;
  pointer-events: none;
  z-index: -3;
}
#bg-hero {
  background-image: url('hero.png');
  opacity: 1;
  animation: heroZoom 25s infinite alternate ease-in-out;
}
#bg-prologue {
  background-image: url('prologue-bg.jpg');
  opacity: 0;
}

@keyframes heroZoom {
  0% { transform: scale(1) translateX(0); }
  100% { transform: scale(1.1) translateX(-2%); }
}
.hero-content { position: relative; z-index: 2; padding-top: 80px; }
.hero-badge { margin-bottom: 24px; }
.hero-title { font-size: 96px; font-weight: 850; color: var(--text); margin-bottom: 16px; letter-spacing: 6px; font-family: "Ma Shan Zheng", "ZCOOL XiaoWei", "STKaiti", "KaiTi", serif; text-shadow: 0 4px 20px rgba(0,0,0,0.5); }
.hero-subtitle { font-size: 32px; color: var(--text2); margin-bottom: 48px; font-family: "Ma Shan Zheng", "ZCOOL XiaoWei", "STKaiti", "KaiTi", serif; text-shadow: 0 2px 12px rgba(0,0,0,0.4); }
.hero-scroll { margin-top: 60px; }
.hero-scroll svg { width: 32px; height: 32px; fill: var(--gold); animation: pulseDown 2s infinite; }
@keyframes pulseDown {
  0%, 100% { transform: translateY(0); opacity: 1; }
  50% { transform: translateY(12px); opacity: 0.4; }
}
@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(12px); } }

/* Loading */
#loader {
  position: fixed; inset: 0; z-index: 9999; background: var(--bg);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  transition: opacity 0.6s, visibility 0.6s;
}
#loader.hidden { opacity: 0; visibility: hidden; }
.loader-ball { width: 60px; height: 60px; position: relative; }
.loader-ball svg { width: 100%; height: 100%; animation: spin 1.5s linear infinite; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.loader-text { margin-top: 20px; font-size: 14px; color: var(--text3); }
.loader-progress { width: 200px; height: 4px; background: var(--bg-card); border-radius: 2px; margin-top: 16px; overflow: hidden; }
.loader-progress-inner { height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold2)); width: 0%; transition: width 0.3s; }

/* 粒子画布 */
#particleCanvas {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.4;
}

/* 视差效果 */
.parallax-layer {
  transition: transform 0.1s ease-out;
}

/* Hero标题逐字动画 */
.hero-title span {
  display: inline-block;
  opacity: 0;
  transform: translateY(20px);
  animation: charAppear 0.6s ease forwards;
}
@keyframes charAppear {
  to { opacity: 1; transform: translateY(0); }
}

/* Chart containers */
.chart-container {
  width: 100%; height: 500px;
  background: rgba(0,30,15,0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,191,0.12);
  border-radius: 16px;
  margin: 24px 0; padding: 20px;
  overflow: hidden; position: relative;
  box-sizing: border-box;
  box-shadow: 0 8px 32px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,191,0.05);
}
.chart-row { display: flex; gap: 20px; margin: 24px 0; }
.chart-half { flex: 1; margin: 0; height: 460px; }
.chart-container > div[id^="chart"] { width: 100%; height: calc(100% - 56px) !important; }
.chart-title { font-size: 18px; color: var(--gold); margin-bottom: 8px; font-weight: 700; text-shadow: 0 2px 6px rgba(0,0,0,0.5); }
.chart-desc { font-size: 13px; color: var(--text3); margin-bottom: 12px; text-shadow: 0 1px 3px rgba(0,0,0,0.4); }

/* Text readability enhancement */
.section-title, .section-subtitle, .story-text, .hint-text, .stat-value, .stat-label, .kpi-value, .kpi-label { text-shadow: 0 1px 4px rgba(0,0,0,0.4); }

/* Person cards */
.person-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; margin-top: 32px; }
.person-card {
  background: linear-gradient(180deg, rgba(26,152,80,0.8) 0%, rgba(0,104,55,0.9) 100%);
  border: 1px solid rgba(217,239,139,0.15); border-radius: 12px; overflow: hidden;
  cursor: pointer; transition: transform 0.3s, box-shadow 0.3s; position: relative;
}
.person-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,104,55,0.4), 0 0 30px rgba(217,239,139,0.1); }
.person-card-photo { width: 100%; height: 200px; background: linear-gradient(135deg, var(--bg-card), var(--bg-hover)); display: flex; align-items: center; justify-content: center; position: relative; }
.person-card-photo::after { content: ""; position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" opacity="0.05"><rect fill="%23f1edf1" width="40" height="40"/></svg>'); }
.person-card-photo svg { width: 80px; height: 80px; opacity: 0.3; }
.person-card-info { padding: 16px; }
.person-card-name { font-size: 18px; font-weight: 700; color: var(--gold); }
.person-card-title { font-size: 13px; color: var(--text3); margin-top: 4px; }
.person-card-quote { font-size: 14px; color: var(--text2); margin-top: 12px; font-style: italic; border-left: 3px solid var(--gold); padding-left: 12px; }

/* Modal */
.modal-overlay {
  position: fixed; inset: 0; z-index: 2000; background: rgba(0,104,55,0.7); backdrop-filter: blur(8px);
  display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}
.modal-overlay.active { opacity: 1; visibility: visible; }
.modal-content {
  width: 90%; max-width: 800px; max-height: 85vh; overflow-y: auto;
  background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg) 100%);
  border: 1px solid rgba(217,239,139,0.2); border-radius: 16px; padding: 32px;
  position: relative; transform: translateY(20px); transition: transform 0.3s;
}
.modal-overlay.active .modal-content { transform: translateY(0); }
.modal-close { position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; cursor: pointer; background: none; border: none; color: var(--text3); font-size: 24px; transition: color 0.2s; }
.modal-close:hover { color: var(--gold); }
.modal-photo { width: 100%; height: 240px; background: linear-gradient(135deg, var(--bg-card), var(--bg-hover)); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
.modal-photo svg { width: 80px; height: 80px; opacity: 0.3; }
.modal-name { font-size: 28px; color: var(--gold); margin-bottom: 4px; }
.modal-title { font-size: 15px; color: var(--text3); margin-bottom: 20px; }
.modal-story { font-size: 15px; color: var(--text2); line-height: 2; margin-bottom: 20px; }
.modal-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }
.stat-item { background: rgba(217,239,139,0.08); padding: 12px; border-radius: 8px; text-align: center; }
.stat-value { font-size: 24px; color: var(--gold); font-weight: 700; }
.stat-label { font-size: 12px; color: var(--text3); margin-top: 4px; }

/* Map wrapper */
.map-wrapper { width: 100%; height: 600px; background: rgba(0,104,55,0.3); border: 1px solid rgba(255,255,191,0.1); border-radius: 12px; margin: 24px 0; position: relative; overflow: hidden; box-sizing: border-box; }
.map-wrapper > div[id] { width: 100%; height: calc(100% - 56px) !important; }

/* Carousel */
#prologueCarousel { width: 80%; max-width: 800px; margin: 32px auto; }
#prologueCarousel .carousel-item { height: auto; aspect-ratio: 3/2; }
.carousel { position: relative; overflow: hidden; border-radius: 12px; margin: 24px 0; }
.carousel-track { display: flex; transition: transform 0.5s ease; }
.carousel-item { min-width: 100%; height: 400px; background: linear-gradient(135deg, var(--bg-card), var(--bg-hover)); display: flex; align-items: center; justify-content: center; }
.carousel-item svg { width: 120px; height: 120px; opacity: 0.2; }
.carousel-dots { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; }
.carousel-dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,191,0.3); cursor: pointer; transition: background 0.2s; }
.carousel-dot.active { background: var(--gold); }

/* KPI Dashboard */
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin: 32px 0; }
.kpi-card {
  background: rgba(26,58,26,0.45);
  backdrop-filter: blur(8px);
