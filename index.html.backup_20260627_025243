        { value: 72, name: '基础设施\n承载压力', center: ['20%', '55%'] },
        { value: 65, name: '产业\n单一依赖', center: ['50%', '55%'] },
        { value: 58, name: '季节性\n波动风险', center: ['80%', '55%'] }
      ];
      var gaugeSeries = isMobile ? [
        {
          type: 'gauge',
          center: ['50%', '45%'],
          radius: '70%',
          min: 0, max: 100,
          startAngle: 210, endAngle: -30,
          axisLine: {
            lineStyle: {
              width: 14,
              color: [
                [0.3, '#66BD63'],
                [0.5, '#D9EF8B'],
                [0.7, '#FDAE61'],
                [1, '#A50026']
              ]
            }
          },
          pointer: { length: '60%', width: 5, itemStyle: { color: '#FFFFBF' } },
          axisTick: { distance: -20, length: 6, lineStyle: { color: 'auto' } },
          splitLine: { distance: -22, length: 12, lineStyle: { color: 'auto' } },
          axisLabel: { distance: -10, color: 'rgba(217,239,139,0.6)', fontSize: 10 },
          title: { offsetCenter: [0, '75%'], fontSize: 12, color: '#FFFFBF' },
          detail: { fontSize: 28, offsetCenter: [0, '45%'], formatter: '{value}', color: '#FFFFBF', fontWeight: 'bold' },
          data: [{ value: 72, name: '基础设施\n承载压力' }]
        }
      ] : gaugeData.map(function(d) {
        return {
          type: 'gauge',
          center: d.center,
          radius: '70%',
          min: 0, max: 100,
          startAngle: 210, endAngle: -30,
          axisLine: {
            lineStyle: {
              width: 14,
              color: [
                [0.3, '#66BD63'],
                [0.5, '#D9EF8B'],
                [0.7, '#FDAE61'],
                [1, '#A50026']
              ]
            }
          },
          pointer: { length: '60%', width: 5, itemStyle: { color: '#FFFFBF' } },
          axisTick: { distance: -20, length: 6, lineStyle: { color: 'auto' } },
          splitLine: { distance: -22, length: 12, lineStyle: { color: 'auto' } },
          axisLabel: { distance: -10, color: 'rgba(217,239,139,0.6)', fontSize: mFont(9) },
          title: { offsetCenter: [0, '75%'], fontSize: mFont(12), color: '#FFFFBF' },
          detail: { fontSize: mFont(24), offsetCenter: [0, '45%'], formatter: '{value}', color: '#FFFFBF', fontWeight: 'bold' },
          data: [{ value: d.value, name: d.name }]
        };
      });
      chart.setOption({
        backgroundColor: 'transparent',
        tooltip: { confine: true, backgroundColor: 'rgba(0,104,55,0.92)', borderColor: '#D9EF8B', textStyle: { color: '#FFFFBF' } },
        series: gaugeSeries
      });
      if (isMobile) {
        var chartDom = document.getElementById('chartRiskGauge');
        if (chartDom) {
          chartDom.insertAdjacentHTML('afterend', '<div style="text-align:center;margin-top:8px;color:#FFFFBF;font-size:13px;"><span style="color:#D9EF8B;">产业单一依赖: 65</span> · <span style="color:#FEE08B;">季节性波动: 58</span></div>');
        }
      }
    } catch(e) { console.error('chartRiskGauge', e); }
  })();

  // ===== RESIZE HANDLER =====
  window.addEventListener('resize', () => {
    Object.values(charts).forEach(c => { if (c && c.resize) c.resize(); });
  });
});
</script>
</body>
